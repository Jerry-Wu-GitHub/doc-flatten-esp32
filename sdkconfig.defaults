# ESP32-S3 (16MB flash + 8MB PSRAM) + DocCorner 默认配置

# 240MHz 双核，编译器 -O2
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# PSRAM：N8R8 模组是 OCT + 80MHz（QUAD 模组请改成 MODE_QUAD）
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

# Flash 16MB
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# 自定义分区表（app 3MB + storage SPIFFS 13.5MB，见 partitions.csv）
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 控制台走 UART0（开发板 CH343 -> COM3）。
# 921600 用于把图片 base64 回传电脑；若串口不稳定可改成 115200。
# 注意：IDF 只有选择 "Custom UART" 时，波特率配置项才可写进 defaults。
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_CUSTOM_NUM_0=y
CONFIG_ESP_CONSOLE_UART_TX_GPIO=43
CONFIG_ESP_CONSOLE_UART_RX_GPIO=44
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600
CONFIG_ESPTOOLPY_MONITOR_BAUD=921600
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# esp-nn 默认就是 Optimized，无需额外配置（见 managed_components/espressif__esp-nn/Kconfig.projbuild）
